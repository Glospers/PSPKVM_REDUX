#
# JSR 184 (Mobile 3D Graphics) component configuration.
#
# This file is included by midp/build/common/makefiles/Subsystems.gmk when
# USE_JSR_184 is true. It follows the same shape as the other optional JSR
# components shipped with phoneME (see jsr172/src/config/subsystem.gmk).
#
# This program is free software; you can redistribute it and/or modify it
# under the terms of the GNU General Public License version 2 only, as
# published by the Free Software Foundation.
#
######################################################################

# Add to global SUBSYSTEMS list
SUBSYSTEMS += jsr_184

INTERNAL_JSR_184_CLASSES_DIR = $(JSR_184_DIR)/src/classes

# Javadoc
SUBSYSTEM_JSR184_SOURCEPATH += $(INTERNAL_JSR_184_CLASSES_DIR)
SUBSYSTEM_JSR184_PACKAGES    = javax.microedition.m3g

MIDP_JAVADOC_SOURCEPATH += $(SUBSYSTEM_JSR184_SOURCEPATH)
MIDP_JAVADOC_PACKAGES   += $(SUBSYSTEM_JSR184_PACKAGES)

MIDP_JAVADOC_ALL += \
	-group "JSR184 Mobile 3D Graphics" \
	$(shell echo $(SUBSYSTEM_JSR184_PACKAGES) | tr ' ' $(PATHSEP))

# Java files for the ( jsr_184 ) module
SUBSYSTEM_JSR_184_JAVA_FILES := \
	$(shell (find $(INTERNAL_JSR_184_CLASSES_DIR) -name '*.java' | egrep -v 'SCCS'))

######################################################################
# Native code
#
# SubsystemDefs.gmk turns SUBSYSTEM_JSR_184_NATIVE_FILES into objects of
# libmidp.a (via JTWI_NATIVE_FILES; see docker/patches/0037), and it looks the
# sources up by bare basename through vpath -- the same arrangement jsr179
# uses at jsr179/src/config/subsystem.gmk:111-115.
######################################################################

INTERNAL_JSR_184_NATIVE_DIR = $(JSR_184_DIR)/src/native

vpath % $(INTERNAL_JSR_184_NATIVE_DIR)

SUBSYSTEM_JSR_184_NATIVE_FILES = \
	m3g_loader_kni.c \
	m3g_graphics3d_kni.c \
	m3g_object_kni.c

# The natives call the M3G engine through m3g/inc/M3G/m3g_psp.h. The engine
# itself is a separate static library built ahead of MIDP (m3g/Makefile) and
# linked into the ELF by docker/patches/0042; only its headers are needed here.
SUBSYSTEM_JSR_184_EXTRA_INCLUDES = -I$(JSR_184_DIR)/../m3g/inc

# BISECT SWITCH -- TEMPORARY, REMOVE THIS LINE TO RE-ENABLE THE OBJECT LAYER.
#
# Makes every m3gCreate* refuse, so Object3D.handle stays 0 for everything a
# MIDlet constructs -- the state the class library was in before the object
# layer existed. Nothing else changes: all 158 natives are still linked, the
# Loader path and its accessors still work, the GL context is still held.
#
# It exists to answer one question: is the memory corruption caused by building
# engine objects at all? See the note above m3gIface in
# jsr184/src/native/m3g_object_kni.c.
SUBSYSTEM_JSR_184_EXTRA_INCLUDES += -DM3G_NO_OBJECT_CREATION

# BISECT SWITCH -- TEMPORARY, REMOVE THIS LINE TO RE-ENABLE Object3D.animate().
#
# m3gAnimate walks the whole subtree through applyAnimation, writing node
# transforms, morph weights, material colours and camera parameters. It is the
# broadest write of any accessor in this file and the only one the engine
# drives recursively. On main it returned 0 without touching the engine, so it
# has never actually run on this platform -- and the title calls it every frame,
# immediately after a scene loads.
SUBSYSTEM_JSR_184_EXTRA_INCLUDES += -DM3G_NO_ANIMATE

# SubsystemDefs.gmk's JSR-184 block only forwards the file lists, so -- as in
# jsr179/src/config/subsystem.gmk:189 -- the include path is added here.
EXTRA_INCLUDES += $(SUBSYSTEM_JSR_184_EXTRA_INCLUDES)
