# Let Git normalize line endings by default.
* text=auto

# Shell scripts and the Dockerfile run inside the Linux build container and MUST
# keep LF endings — otherwise a CRLF checkout on Windows breaks them at runtime.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.mk        text eol=lf
Makefile    text eol=lf

# Patches are byte-sensitive; never let Git touch their endings.
*.patch     -text
*.diff      -text

# JSR component sources are compiled inside the Linux container
*.java  eol=lf
*.gmk   eol=lf

# So are the M3G native sources
m3g/**/*.c  eol=lf
m3g/**/*.h  eol=lf

# ...and the JSR 184 natives, which are copied into the phoneME tree and built
# there. Left to text=auto they come out CRLF on a Windows checkout, which the
# container's build then has to tolerate for no reason.
jsr184/**/*.c  eol=lf
jsr184/**/*.h  eol=lf
