 	c->current_matrix = &s->stack[s->depth];
 
-	/* Load up the new VFPU state */
-	assert((s->flags & MF_VFPU) == 0);
-	__pspgl_matrix_load(c, s);
+	/* Load up the new VFPU state; uncached stacks stay in memory */
