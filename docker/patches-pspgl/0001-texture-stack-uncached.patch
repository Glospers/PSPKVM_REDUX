diff --git a/pspgl_matrix.c b/pspgl_matrix.c
index 75a1cd2..ad90abf 100644
--- a/pspgl_matrix.c
+++ b/pspgl_matrix.c
@@ -44,9 +44,62 @@ void __pspgl_matrix_load(struct pspgl_context *c, struct pspgl_matrix_stack *s)
 	s->flags |= MF_VFPU;
 }
 
+/* The texture stack bypasses the VFPU top-of-stack cache: the GE
+   texture matrix has proven impossible to keep coherent under the lazy
+   VFPU cache (per-draw MF_ADJUST changes don't dirty the stack, and
+   the adjust fold drops the cached top from the VFPU keepset
+   mid-flush, so a stale save-slot copy can be restored over freshly
+   loaded values).  For an uncached stack the in-memory copy is always
+   authoritative: MF_VFPU is never set on it, and all mutations are
+   done in plain C. */
+int __pspgl_matrix_nocache(const struct pspgl_context *c, const struct pspgl_matrix_stack *s)
+{
+	return s == &c->texture_stack;
+}
+
+void __pspgl_matrix_mem_load(struct pspgl_matrix_stack *s, const GLfloat *m16)
+{
+	struct pspgl_matrix *mat = &s->stack[s->depth];
+	int i;
+
+	if (m16 == NULL)
+		m16 = __pspgl_identity;
+
+	for (i = 0; i < 16; i++)
+		mat->mat[i] = m16[i];
+
+	mat->flags &= ~MF_IDENTITY;
+	if (!(s->flags & MF_DISABLED))
+		s->flags |= MF_DIRTY;
+}
+
+/* top = top * m, column-major (standard GL right-multiply) */
+void __pspgl_matrix_mem_mult(struct pspgl_matrix_stack *s, const GLfloat *m16)
+{
+	struct pspgl_matrix *mat = &s->stack[s->depth];
+	const GLfloat *a = mat->mat;
+	GLfloat r[16];
+	int i, j;
+
+	for (j = 0; j < 4; j++)
+		for (i = 0; i < 4; i++)
+			r[4*j+i] = a[i]      * m16[4*j]   +
+				   a[4+i]  * m16[4*j+1] +
+				   a[8+i]  * m16[4*j+2] +
+				   a[12+i] * m16[4*j+3];
+
+	for (i = 0; i < 16; i++)
+		mat->mat[i] = r[i];
+
+	mat->flags &= ~MF_IDENTITY;
+	if (!(s->flags & MF_DISABLED))
+		s->flags |= MF_DIRTY;
+}
+
