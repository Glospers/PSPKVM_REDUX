diff --git a/glRotatef.c b/glRotatef.c
index 25577ce..8c4c454 100644
--- a/glRotatef.c
+++ b/glRotatef.c
@@ -3,6 +3,7 @@
 #include <pspvfpu.h>
 
 #include "pspgl_internal.h"
+#include "pspgl_matrix.h"
 
 void glRotatef (GLfloat angle, GLfloat x, GLfloat y, GLfloat z)
 {
@@ -66,6 +67,40 @@ void glRotatef (GLfloat angle, GLfloat x, GLfloat y, GLfloat z)
 	struct pspgl_matrix_stack *stk = c->current_matrix_stack;
 	struct pspgl_matrix *mat = c->current_matrix;
 
+	if (__pspgl_matrix_nocache(c, stk)) {
+		/* Plain-C axis-angle rotate for uncached stacks (same
+		   math as the reference implementation above). */
+		GLfloat m[16];
+		GLfloat s, co, omc, scale;
+		GLfloat xx, yy, zz, xy, yz, zx, xs, ys, zs;
+
+		scale = sqrtf(x*x + y*y + z*z);
+		if (scale < 1.0e-4f)
+			return;
+
+		angle *= (M_PI/180.f);
+		s = sinf(angle);
+		co = cosf(angle);
+
+		scale = 1.f / scale;
+		x *= scale;
+		y *= scale;
+		z *= scale;
+
+		xx = x*x; yy = y*y; zz = z*z;
+		xy = x*y; yz = y*z; zx = z*x;
+		xs = x*s; ys = y*s; zs = z*s;
+		omc = 1.f - co;
+
+		m[0]  = omc*xx + co; m[1]  = omc*xy + zs; m[2]  = omc*zx - ys; m[3]  = 0.f;
+		m[4]  = omc*xy - zs; m[5]  = omc*yy + co; m[6]  = omc*yz + xs; m[7]  = 0.f;
+		m[8]  = omc*zx + ys; m[9]  = omc*yz - xs; m[10] = omc*zz + co; m[11] = 0.f;
+		m[12] = 0.f;         m[13] = 0.f;         m[14] = 0.f;         m[15] = 1.f;
+
+		__pspgl_matrix_mem_mult(stk, m);
+		return;
+	}
+
 	if (!(stk->flags & MF_DISABLED))
 		stk->flags |= MF_DIRTY;
 
