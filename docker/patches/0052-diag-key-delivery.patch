 #include <pspthreadman.h>
 #include <pspctrl.h>
+#include <stdio.h>
 
 extern int suspend_key_input;
 static int key_thread_id = -1;
 static int done = 0;
 
+/* TEMPORARY -- key-delivery diagnostic.  A soft button that does nothing has
+ * three possible failure points: the pad mask never arrives from the host,
+ * the keymap drops it, or the Java side ignores what was delivered.  One
+ * line per raw pad transition and one per delivered Java key tells which.
+ * Budgeted; the writer opens-appends-closes per line (logging.c), so the
+ * small stack of this thread is enough. */
+extern void javacall_diag_log(const char *s);
+static int s_keyDiagBudget = 120;
+
+static void key_diag(const char *tag, unsigned int pspMask, int javaKey)
+{
+	char l[64];
+	if (s_keyDiagBudget <= 0) {
+		return;
+	}
+	s_keyDiagBudget--;
+	sprintf(l, "KEY: %s psp=%08x java=%d\n", tag, pspMask, javaKey);
+	javacall_diag_log(l);
+}
+
 #define PSP_CTRL_ANALOG_LEFT 	0x10000000
 #define PSP_CTRL_ANALOG_RIGHT 	0x20000000
 #define PSP_CTRL_ANALOG_UP 		0x40000000
