+/* Diagnostic boot trace: mirror everything that reaches javacall_print to a
+ * file on the memory stick (ms0:/pspkvm_boot.log). Open/write/close per call so
+ * the last lines are guaranteed on disk even if the VM hangs afterwards. The
+ * first write truncates so each boot starts a fresh log. */
+static void log_2_file(const char *s) {
+    static int first = 1;
+    int flags = PSP_O_WRONLY | PSP_O_CREAT | PSP_O_APPEND;
+    int fd = sceIoOpen("ms0:/pspkvm_boot.log", flags, 0777);
+    if (fd >= 0) {
+        first = 0;
+        sceIoWrite(fd, s, strlen(s));
+        sceIoClose(fd);
+    }
+}
+
 /**
  * Prints out a string to a system specific output strream
  *
  * @param s a NULL terminated character buffer to be printed
 */
 void javacall_print(const char *s) {
-    
+
+    log_2_file(s);
+
     if (log_channel_consle) pspDebugScreenPrintf(s);
     if (log_channel_startup) pspkvm_screen_log(s);
     if (log_channel_stdout) printf(s);
