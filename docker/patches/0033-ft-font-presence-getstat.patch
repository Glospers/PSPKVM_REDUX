diff --git a/javacall/implementation/psp_mips/midp/ft_support.c b/javacall/implementation/psp_mips/midp/ft_support.c
index d2d082f..a436e63 100755
--- a/javacall/implementation/psp_mips/midp/ft_support.c
+++ b/javacall/implementation/psp_mips/midp/ft_support.c
@@ -1,6 +1,28 @@
 #include "ft_support.h"
 #include "alpha_blend.h"
 #include <unistd.h>
+#include <stdio.h>
+#include <pspiofilemgr.h>
+
+/* Modern pspdev newlib file glue is unreliable on the PSP: lseek() and
+   fstat() both return garbage (see javacall/.../common/file.c) and access()
+   is in the same family. When access() wrongly reports the .ttf files
+   absent, initialize_face_ids() takes its "no system font at all" early
+   return and leaves ftc_faceids[] unpopulated, so get_face_id() hands
+   FreeType a bogus FTC_FaceID which fts_face_requester() passes to
+   FT_New_Face() as a path -- fopen() then walks that wild pointer and
+   faults inside __get_drive(). Ask the kernel directly instead;
+   sceIoGetstat() does not resolve paths against the process cwd, so build
+   a device-qualified absolute path from getcwd(). */
+static int ft_file_present(const char* fn) {
+	char abspath[512];
+	char cwd[512];
+	SceIoStat st;
+	cwd[0] = 0;
+	getcwd(cwd, sizeof(cwd));
+	snprintf(abspath, sizeof(abspath), "%s/%s", cwd, fn);
+	return (sceIoGetstat(abspath, &st) >= 0) ? 1 : 0;
+}
 
