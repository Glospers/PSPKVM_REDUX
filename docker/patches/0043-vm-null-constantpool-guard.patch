+/**
+ * Appends one line to ms0:/pspkvm_vm.log.
+ *
+ * javacall_print() only reaches a channel that javacall_logging_channel()
+ * has switched on, and every channel above defaults to off, so it is not a
+ * usable sink for a report that has to survive a VM-level failure. This one
+ * opens, writes and closes per call and appends, so the last line written
+ * is always on the memory stick even if the VM dies immediately after it.
+ * Only fatal paths call it, so the cost does not matter.
+ */
+void javacall_diag_log(const char *s) {
+    int fd = sceIoOpen("ms0:/pspkvm_vm.log",
+                       PSP_O_WRONLY | PSP_O_CREAT | PSP_O_APPEND, 0777);
+    if (fd >= 0) {
+        sceIoWrite(fd, s, strlen(s));
+        sceIoClose(fd);
+    }
+}
