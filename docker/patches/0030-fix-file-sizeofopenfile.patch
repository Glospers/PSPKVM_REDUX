+   fills newlib's struct stat with a mismatched layout (st_size reads as e.g.
+   73 for a 5776-byte file). So javacall_file_sizeofopenfile() cannot use
+   either. Instead we remember the OS path for every open fd and query the
+   size with sceIoGetstat(), which fills the native SceIoStat correctly (this
+   is the same call javacall_file_sizeof() already relied on). */
+#define JC_MAX_FD 64
+static char jc_fd_path[JC_MAX_FD][MAX_FILE_NAME_LEN+1];
+
+static void jc_fd_path_set(int fd, const char* path) {
+    if (fd >= 0 && fd < JC_MAX_FD) {
+        strncpy(jc_fd_path[fd], path, MAX_FILE_NAME_LEN);
+        jc_fd_path[fd][MAX_FILE_NAME_LEN] = 0;
+    }
+}
+static void jc_fd_path_clear(int fd) {
+    if (fd >= 0 && fd < JC_MAX_FD) {
+        jc_fd_path[fd][0] = 0;
+    }
+}
