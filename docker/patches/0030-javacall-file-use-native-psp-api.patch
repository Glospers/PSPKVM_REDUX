 #include <pspiofilemgr.h>
 #define MAX_FILE_NAME_LEN JAVACALL_MAX_FILE_NAME_LENGTH
 
+/* The modern pspdev newlib file layer is unreliable on the PSP: lseek() ignores
+   its `whence` and returns a RAM address, fstat() fills a mismatched struct,
+   access() misreports existence and readdir() never terminates. Reading a JAR
+   needs working seeks, so this port talks to the kernel (sceIo*) directly.
+   Those calls do not resolve paths against the process cwd, so a relative path
+   must be made absolute first; an absolute PSP path carries a device prefix
+   such as "ms0:". */
+static const char* jc_abspath(const char* in, char* out, int outsz) {
+    char cwd[JAVACALL_MAX_FILE_NAME_LENGTH + 1];
+    const char* rel = in;
+    if (strchr(in, ':') != NULL) {
+        return in;
+    }
+    cwd[0] = 0;
+    if (getcwd(cwd, sizeof(cwd)) == NULL || cwd[0] == 0) {
+        return in;
+    }
+    if (rel[0] == '.' && rel[1] == '/') {
+        rel += 2;
+    } else if (rel[0] == '/') {
+        rel += 1;
+    }
+    snprintf(out, outsz, "%s/%s", cwd, rel);
+    return out;
+}
+
+/* sceIoRead()/sceIoWrite() cannot DMA to every address the CPU can reach: the
+   pcsl pool sits at a low RAM mirror the kernel rejects, so file data is copied
+   through a stack bounce buffer, which is always valid. */
+
