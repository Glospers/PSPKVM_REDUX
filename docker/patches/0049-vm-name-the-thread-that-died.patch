+// Diagnostic: name a thread that died, on a sink that exists in this build.
+//
+// The report below this one goes to tty, and from there through JVMSPI_PrintRaw
+// to javacall_print -- but print_current_pending_exception_stack_trace produces
+// nothing once the class library is romized, so all that survives is a banner
+// with no exception on it. A MIDlet thread can therefore die and leave the VM
+// with nothing runnable, which from the outside is indistinguishable from a
+// deadlock: the screen holds its last frame and the event loop polls forever.
+//
+// So write the class name straight to the diagnostic log, taking the bytes off
+// the class's own Symbol rather than asking anything to print it. Weak because
+// the same sources build the romizer, which runs on the build machine and has
+// no javacall behind it.
+extern "C" void javacall_diag_log(const char *s) __attribute__((weak));
+
+static void report_uncaught_exception(BasicOop *exception) {
+  char line[128];
+  int i, length;
+
+  if (javacall_diag_log == 0) {
+    return;
+  }
+
+  JavaClass::Raw klass = exception->blueprint();
+  Symbol::Raw name = klass().name();
+
+  jvm_strcpy(line, "VM: thread died, uncaught ");
+  length = jvm_strlen(line);
+
+  for (i = 0; i < name().length() && length < (int)sizeof(line) - 2; i++) {
+    char c = (char) name().byte_at(i);
+    line[length++] = (c == '/') ? '.' : c;
+  }
+  line[length++] = '\n';
+  line[length] = '\0';
+
+  javacall_diag_log(line);
+}
