@@ -433,6 +433,39 @@ javacall_result javacall_media_finalize(void) {
  * 
  * @return              Handle of native library. if fail return NULL.
  */
+/*
+ * MIME matching that survives what MIDlets actually pass.
+ *
+ * The routing below used to be strcmp against a fixed list, which misses on
+ * three things seen in real suites: type names are case-insensitive by
+ * RFC 2045 but were compared case-sensitively, a type may carry parameters
+ * ("audio/midi; rate=..."), and leading space is common. Our own AMR routing
+ * already had to special-case "audio/AMR" for exactly this reason.
+ */
+static int mime_is(const char *mime, const char *want)
+{
+    int i, j;
+
+    if (mime == NULL || want == NULL) {
+        return 0;
+    }
+    while (*mime == 32 || *mime == 9) {
+        mime++;
+    }
+
+    for (i = 0, j = 0; want[j] != 0; i++, j++) {
+        int a = mime[i];
+        int b = want[j];
+        if (a >= 65 && a <= 90) a += 32;     /* ASCII upper to lower */
+        if (b >= 65 && b <= 90) b += 32;
+        if (a != b) {
+            return 0;
+        }
+    }
+    /* Matched the whole type: it must end here, or a parameter follows. */
+    return mime[i] == 0 || mime[i] == 59 || mime[i] == 32 || mime[i] == 9;
+}
+
 javacall_handle javacall_media_create(javacall_int64 playerId, 
                                       const javacall_utf16* mime, 
                                       long mimeLength,
@@ -467,27 +500,48 @@ javacall_handle javacall_media_create(javacall_int64 playerId,
         }
