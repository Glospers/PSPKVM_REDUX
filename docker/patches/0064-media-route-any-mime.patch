-
-    return NULL;
+    /* MIDI, including the Scalable Polyphony profile. SP-MIDI is ordinary
+       MIDI with a scalability header that Timidity ignores, and it is common
+       in J2ME suites -- it was simply never routed, so every game using it
+       was silent with nothing logged. */
+    if (mime_is(pszMime, JAVACALL_AUDIO_MIDI_MIME)   ||
+        mime_is(pszMime, JAVACALL_AUDIO_MIDI_MIME_2) ||
+        mime_is(pszMime, JAVACALL_AUDIO_SP_MIDI_MIME) ||
+        mime_is(pszMime, "audio/x-midi") ||
+        mime_is(pszMime, "audio/x-mid")) {
+        return create_midi(playerId, uri, uriLength, contentLength);
+    }
+
+    if (mime_is(pszMime, JAVACALL_AUDIO_MP3_MIME)   ||
+        mime_is(pszMime, JAVACALL_AUDIO_MP3_MIME_2) ||
+        mime_is(pszMime, "audio/x-mp3") ||
+        mime_is(pszMime, "audio/mpeg3")) {
+        return create_mp3(playerId, uri, uriLength, contentLength);
+    }
+
+    /* WAVE, AMR, and anything not recognised above.
+       Returning NULL here is what a MIDlet experiences as "no sound at all",
+       and the old code did that for every type outside a list of six. The
+       sampled-audio player is the better default: it inspects the bytes when
+       they arrive rather than trusting the declared type, so it plays WAVE,
+       decodes AMR, and fails per-clip instead of refusing up front. Anything
+       that lands here unrecognised is logged with its type, so the next
+       unknown format is a one-line diagnosis rather than an investigation. */
+    if (!mime_is(pszMime, JAVACALL_AUDIO_WAV_MIME)   &&
+        !mime_is(pszMime, JAVACALL_AUDIO_WAV_MIME_2) &&
+        !mime_is(pszMime, JAVACALL_AUDIO_AMR_MIME)) {
+        extern void javacall_diag_log(const char *s) __attribute__((weak));
+        static int logged_unknown;
+        if (logged_unknown < 20 && javacall_diag_log != 0) {
+            char line[128];
+            logged_unknown++;
+            sprintf(line, "media: unrouted mime=%.60s len=%ld -> wav player\n",
+                    (pszMime != NULL) ? pszMime : "(null)", contentLength);
+            javacall_diag_log(line);
+        }
+    }
+
+    return create_wav(playerId, uri, uriLength, contentLength);
