+/*
+ * Keep near-white distinct from true white across the 565 round trip.
+ * getRGB reconstructs by bit replication, so a channel of 248..254
+ * (252..254 for green) would read back as exactly 255; games colorkey
+ * on pure opaque white and rely on fills at 253,253,253 staying
+ * distinct.  Nudge the top bucket down one code before truncation.
+ */
+static jint imgj_preserve_whitekey(jint rgb) {
+    jint r = (rgb >> 16) & 0xff;
+    jint g = (rgb >>  8) & 0xff;
+    jint b =  rgb        & 0xff;
+    if (r >= 0xf8 && r != 0xff) r = 0xf7;
+    if (g >= 0xfc && g != 0xff) g = 0xfb;
+    if (b >= 0xf8 && b != 0xff) b = 0xf7;
+    return (rgb & 0xff000000) | (r << 16) | (g << 8) | b;
+}
+#define PRESERVE_WHITEKEY(x) imgj_preserve_whitekey(x)
