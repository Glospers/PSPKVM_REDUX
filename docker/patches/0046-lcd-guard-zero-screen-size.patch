     		if (javacall_devemu_get_rotation(javacall_devemu_get_current_device()) == 90) {
     			/*
     			CopyImageCW90(screen.image, screen.width,
@@ -457,6 +485,25 @@ int javacall_lcd_get_screen_height() {
 }
 
 void javacall_set_new_screen_size(int w, int h) {
+    /*
+     * Refuse a degenerate size.
+     *
+     * vscr_w and vscr_h are the only screen dimensions the flush has, and it
+     * divides by them to letterbox (the scaling branches of
+     * javacall_lcd_flush_partial_internal). A zero here therefore does not
+     * produce a small window, it produces a MIPS divide-by-zero trap on the
+     * next repaint, a long way from whoever asked for it. Keeping the previous
+     * size is the only sane response, and the line logged here names the
+     * values so the caller can be identified.
+     */
+    if (javacall_diag_log != 0) {
+        char line[80];
+        sprintf(line, "LCD: screen size %d x %d\n", w, h);
+        javacall_diag_log(line);
+    }
+    if (w <= 0 || h <= 0) {
+        return;
+    }
     if (w == vscr_w && h == vscr_h) {
         return;
     }
